# Configuración del servidor local de planta. `install.sh` crea el .env real a
# partir de este archivo y completa los secretos; aquí solo como referencia.

# --- Nube a la que se sincroniza ---
SYNC_CLOUD_URL=https://api.servilion.cl
# Se obtiene en la nube con: python manage.py sync_register_node antofagasta
SYNC_NODE_TOKEN=

# --- Secretos locales (install.sh los genera) ---
SECRET_KEY=
JWT_SECRET=
POSTGRES_DB=servilion
POSTGRES_USER=servilion
POSTGRES_PASSWORD=

# --- Red local ---
# Puerto al que apuntan las terminales: http://<IP-de-este-equipo>:8000
API_PORT=8000
ALLOWED_HOSTS=*
DEBUG=False
# En la LAN no hay HTTPS: las cookies seguras y la redirección se apagan.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# --- Sesión de las terminales ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Datos que guarda este servidor ---
# Días de guías y pesajes que se conservan aquí. Lo anterior se consulta en la
# nube cuando hay internet. Usuarios, catálogo y hotelería se guardan completos.
SYNC_LOCAL_RETENTION_DAYS=90

# --- Actualizaciones ---
SERVILION_IMAGE=ghcr.io/howlonely/servilion-backend:latest
UPDATE_INTERVAL_SECONDS=300

# --- Fotos de la OT (S3) ---
# Las terminales fotografían la OT física al digitalizarla y la suben directo a
# S3; este servidor solo firma la subida (sin internet la firma igual, pero la
# subida falla y la terminal ofrece reintentar). Usar un usuario IAM que solo
# pueda escribir en guias/fotos/ del bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=servilion-bucket
AWS_S3_REGION_NAME=us-east-1
